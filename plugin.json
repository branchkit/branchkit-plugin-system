{
  "id": "system",
  "name": "System",
  "privileges": [
    "apps",
    "apps.control",
    "audio",
    "filesystem"
  ],
  "version": "1.0.0",
  "min_api_version": "0.1.0",
  "description": "Application registry, app switching HUD, audio control, and system settings.",
  "author": "BranchKit",
  "run": "./system-plugin",
  "action_prefix": "system",
  "action_types": {
    "volume_up": { "label": "Volume Up" },
    "volume_down": { "label": "Volume Down" },
    "mute": { "label": "Mute" },
    "unmute": { "label": "Unmute" },
    "set_output": {
      "label": "Set Audio Output Device",
      "fields": [
        { "key": "name", "label": "Device Name", "field_type": "string", "required": true }
      ]
    },
    "set_input": {
      "label": "Set Audio Input Device",
      "fields": [
        { "key": "name", "label": "Device Name", "field_type": "string", "required": true }
      ]
    },
    "launch": {
      "label": "Launch App",
      "fields": [
        {
          "key": "bundle_id",
          "label": "Bundle ID",
          "placeholder": "com.apple.Safari",
          "field_type": "string",
          "required": true
        },
        {
          "key": "new_instance",
          "label": "New Instance",
          "field_type": "boolean",
          "required": false
        }
      ]
    },
    "new_window": {
      "label": "New Window on Current Space",
      "fields": [
        {
          "key": "bundle_id",
          "label": "Bundle ID",
          "placeholder": "com.google.Chrome",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "open": {
      "label": "Open URL or File",
      "fields": [
        {
          "key": "target",
          "label": "Target",
          "placeholder": "https://example.com",
          "field_type": "string",
          "required": true
        }
      ]
    }
  },
  "hud_targets": [],
  "provides": {
    "collections": {
      "apps": {
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name"
          },
          {
            "key": "bundle_id",
            "field_type": "string",
            "label": "Bundle ID"
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "bundle_id"
        },
        "description": "Installed applications with speakable names and aliases."
      },
      "audio_outputs": {
        "preset": "named_entities",
        "fields": [
          { "key": "spoken", "field_type": "string", "label": "Device name" }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "spoken"
        },
        "description": "Current audio output device names, speakable in 'set output <device>'."
      },
      "audio_inputs": {
        "preset": "named_entities",
        "fields": [
          { "key": "spoken", "field_type": "string", "label": "Device name" }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "spoken"
        },
        "description": "Current audio input device names, speakable in 'set input <device>'."
      },
      "plugin.system.device_aliases": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": { "type": "singleton" },
        "writers": "introducer_only",
        "description": "Audio device UID to spoken alias mappings."
      }
    }
  },
  "consumes": {
    "events": [
      {
        "pattern": "_platform.audio_devices.changed"
      }
    ]
  },
  "collection_data": {
    "voice_commands": "commands.json"
  },
  "implements": {
    "settings_tabs": [
      {
        "label": "Apps",
        "key": "apps"
      },
      {
        "label": "Sound",
        "key": "sound"
      },
      {
        "label": "Devices",
        "key": "devices"
      }
    ],
    "on_action": true,
    "render_settings": true
  }
}