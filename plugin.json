{
  "id": "system",
  "name": "System",
  "capabilities": [
    "apps.control",
    "audio",
    "filesystem",
    "shell"
  ],
  "version": "1.0.0",
  "description": "Application registry, app switching HUD, audio control, and system settings.",
  "author": "BranchKit",
  "run": "./system-plugin",
  "action_prefix": "system",
  "action_types": {
    "launch": {
      "label": "Launch App",
      "fields": [
        {
          "key": "bundleID",
          "label": "Bundle ID",
          "placeholder": "com.apple.Safari",
          "field_type": "string",
          "required": true
        },
        {
          "key": "new_instance",
          "label": "New Instance",
          "field_type": "boolean",
          "required": false
        }
      ]
    },
    "open": {
      "label": "Open URL or File",
      "fields": [
        {
          "key": "target",
          "label": "Target",
          "placeholder": "https://example.com",
          "field_type": "string",
          "required": true
        }
      ]
    }
  },
  "hud_targets": [],
  "store_data": {
    "voice_commands": "commands.json"
  },
  "implements": {
    "settings_tabs": [
      {
        "label": "Apps",
        "key": "apps"
      },
      {
        "label": "Sound",
        "key": "sound"
      }
    ],
    "on_action": true,
    "render_settings": true
  }
}