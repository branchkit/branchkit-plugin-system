package main

import "github.com/branchkit/plugin-sdk-go"
import "github.com/branchkit/plugin-sdk-go/ui"

templ Apps(apps []appRowView, mouseFollowsFocus bool, traits traitCatalog) {
	<div>
		<bk-table columns="1fr 100px" class="apps-prefs">
			<div class="settings-row">
				<div class="label" title="After 'focus <app>' / 'switch <app>', warp the cursor to the app's window so scrolling lands there">Mouse follows focus</div>
				<div class="row-actions">
					if mouseFollowsFocus {
						<span class="badge badge-core clickable"
							data-on:click={ branchkit.MethodPost("set_mouse_follows_focus", "{enabled: false}") }>
							Enabled
						</span>
					} else {
						<span class="badge badge-user clickable"
							data-on:click={ branchkit.MethodPost("set_mouse_follows_focus", "{enabled: true}") }>
							Disabled
						</span>
					}
				</div>
			</div>
		</bk-table>
		<div class="apps-intro">
			<b>Aliases</b> are what you can say to launch an app — yours alone.
			<b>Traits</b> are what the app IS, and every plugin reads them: changing one
			changes how the app is treated everywhere, not just here.
		</div>
		<bk-table columns="1.3fr 1.5fr 1.5fr 90px">
		<div class="table-header">
			<div>Application</div>
			<div>Aliases</div>
			<div>Traits</div>
			<div class="align-right">Status</div>
		</div>
		for _, app := range apps {
			<div class="settings-row">
				<div class="label">{ app.Name }</div>
				<div class="value">
					<div class="alias-tags">
						for _, alias := range app.Aliases {
							<span class="alias-tag">
								{ alias }
								<button data-on:click={ branchkit.MethodPost("app_alias_remove", ui.Args("bundle_id", app.BundleID, "newAlias", alias)) }>&#215;</button>
							</span>
						}
						<div data-show={ "$editingApp === " + ui.JS(app.BundleID) }>
							<input class="add-alias-input" type="text" data-bind="newAlias" placeholder="Add alias…"
								data-on:keydown={ "evt.key === 'Enter' && (" + branchkit.MethodPost("app_alias_add", ui.Args("bundle_id", app.BundleID, "newAlias", ui.Expr("$newAlias"))) + ", $editingApp = ''); evt.key === 'Escape' && ($editingApp = '')" }
								data-on:blur__debounce.200ms="$editingApp = ''"/>
						</div>
						<div data-show={ "$editingApp !== " + ui.JS(app.BundleID) }>
							<button class="icon-btn add-btn" title="Add alias"
								data-on:click={ "$editingApp = " + ui.JS(app.BundleID) + "; $newAlias = ''" }>+</button>
						</div>
					</div>
				</div>
				<div class="value">
					<div class="alias-tags">
						for _, trait := range app.Traits {
							<span class="alias-tag" title={ "This app is a '" + trait + "'. Removing it changes what every plugin believes about this app, not just dictation." }>
								{ trait }
								<button data-on:click={ branchkit.MethodPost("app_trait_remove", ui.Args("bundle_id", app.BundleID, "trait", trait)) }>&#215;</button>
							</span>
						}
						// State 2 — pick from what exists. A select, not a text box:
						// trait names are SHARED between apps, so a typo does not fail
						// loudly the way a mistyped alias does. It points at nothing,
						// silently, forever.
						<div data-show={ "$traitPick === " + ui.JS(app.BundleID) }>
							<select class="add-alias-input"
								data-on:change={ "evt.target.value === '__new__' ? ($traitNew = " + ui.JS(app.BundleID) + ", $traitPick = '', $newTrait = '') : (evt.target.value && (" + traitAddPost(app.BundleID, "evt.target.value") + "), $traitPick = '')" }>
								<option value="">Add trait…</option>
								for _, name := range traits.Names {
									<option value={ name }>{ name } ({ itoa(traits.Counts[name]) })</option>
								}
								<option value="__new__">New trait…</option>
							</select>
						</div>
						// State 3 — inventing a name is one step further than picking one.
						<div data-show={ "$traitNew === " + ui.JS(app.BundleID) }>
							<input class="add-alias-input" type="text" data-bind="newTrait" placeholder="New trait…"
								data-on:keydown={ "evt.key === 'Enter' && (" + traitAddPost(app.BundleID, "$newTrait") + ", $traitNew = ''); evt.key === 'Escape' && ($traitNew = '')" }
								data-on:blur__debounce.200ms="$traitNew = ''"/>
						</div>
						// State 1 — resting.
						<div data-show={ "$traitPick !== " + ui.JS(app.BundleID) + " && $traitNew !== " + ui.JS(app.BundleID) }>
							<button class="icon-btn add-btn" title="Add a trait"
								data-on:click={ "$traitPick = " + ui.JS(app.BundleID) }>+</button>
						</div>
					</div>
				</div>
				<div class="row-actions">
					<span class={ "badge clickable " + app.BadgeClass }
						data-on:click={ branchkit.MethodPost("app_toggle", ui.Args("bundle_id", app.BundleID)) }>
						{ app.Status }
					</span>
				</div>
			</div>
		}
		</bk-table>
	</div>
}
