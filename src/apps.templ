package main

import "github.com/branchkit/plugin-sdk-go"

templ Apps(apps []appRowView, mouseFollowsFocus bool) {
	<div>
		<bk-table columns="1fr 100px" style="margin-bottom: 16px;">
			<div class="settings-row" >
				<div class="label" title="After 'focus <app>' / 'switch <app>', warp the cursor to the app's window so scrolling lands there">Mouse follows focus</div>
				<div class="row-actions">
					if mouseFollowsFocus {
						<span class="badge badge-core" style="cursor: pointer;"
							data-on:click={ branchkit.MethodPost("set_mouse_follows_focus", "{enabled: false}") }>
							Enabled
						</span>
					} else {
						<span class="badge badge-user" style="cursor: pointer;"
							data-on:click={ branchkit.MethodPost("set_mouse_follows_focus", "{enabled: true}") }>
							Disabled
						</span>
					}
				</div>
			</div>
		</bk-table>
		<bk-table columns="1.5fr 2fr 100px">
		<div class="table-header" >
			<div>Application</div>
			<div>Aliases</div>
			<div style="text-align: right;">Status</div>
		</div>
		for _, app := range apps {
			<div class="settings-row" >
				<div class="label">{ app.Name }</div>
				<div class="value">
					<div class="alias-tags">
						for _, alias := range app.Aliases {
							<span class="alias-tag">
								{ alias }
								<button data-on:click={ branchkit.MethodPost("app_alias_remove", "{bundle_id: '"+jsEscape(app.BundleID)+"', newAlias: '"+jsEscape(alias)+"'}") }>&#215;</button>
							</span>
						}
						<div data-show={ "$editingApp === '" + jsEscape(app.BundleID) + "'" }>
							<input class="add-alias-input" type="text" data-bind="newAlias" placeholder="Add alias…"
								data-on:keydown={ "evt.key === 'Enter' && (" + branchkit.MethodPost("app_alias_add", "{bundle_id: '"+jsEscape(app.BundleID)+"', newAlias: $newAlias}") + ", $editingApp = ''); evt.key === 'Escape' && ($editingApp = '')" }
								data-on:blur__debounce.200ms="$editingApp = ''"/>
						</div>
						<div data-show={ "$editingApp !== '" + jsEscape(app.BundleID) + "'" }>
							<button class="icon-btn" style="opacity: 1; font-size: 16px;" title="Add alias"
								data-on:click={ "$editingApp = '" + jsEscape(app.BundleID) + "'; $newAlias = ''" }>+</button>
						</div>
					</div>
				</div>
				<div class="row-actions">
					<span class={ "badge " + app.BadgeClass } style="cursor: pointer;"
						data-on:click={ branchkit.MethodPost("app_toggle", "{bundle_id: '"+jsEscape(app.BundleID)+"'}") }>
						{ app.Status }
					</span>
				</div>
			</div>
		}
		</bk-table>
	</div>
}
