package main

import "github.com/branchkit/plugin-sdk-go"
import "fmt"
import "strconv"

templ deviceList(devices []deviceView, deviceType string) {
	for _, dev := range devices {
		<div class="settings-row">
			<div class="label">
				<div class="sound-device-name-row">
					<span class="clickable" data-on:click={ "@post('" + branchkit.MethodURL("set-device") + "', {payload: {uid: '" + jsEscape(dev.UID) + "', device_type: '" + deviceType + "'}})" }>{ dev.Name }</span>
				</div>
				<div class="sound-device-hints">
					<div class="alias-tags">
						<code class="sound-device-cmd">{ "set " + deviceType + " " + dev.VoiceHint }</code>
						for _, alias := range dev.Aliases {
							<span class="alias-tag">
								{ alias }
								<button data-on:click={ "@post('" + branchkit.MethodURL("device-alias-remove") + "', {payload: {uid: '" + jsEscape(dev.UID) + "', newAlias: '" + jsEscape(alias) + "'}})" }>&#215;</button>
							</span>
						}
						<div data-show={ "$editingDevice === '" + jsEscape(dev.UID) + "'" }>
							<input class="add-alias-input" type="text" data-bind="newAlias" placeholder="e.g. headphones"
								data-on:keydown={ "evt.key === 'Enter' && (@post('" + branchkit.MethodURL("device-alias-add") + "', {payload: {uid: '" + jsEscape(dev.UID) + "', newAlias: $newAlias}}), $editingDevice = ''); evt.key === 'Escape' && ($editingDevice = '')" }
								data-on:blur__debounce.150ms="$editingDevice = ''"/>
						</div>
						<div data-show={ "$editingDevice !== '" + jsEscape(dev.UID) + "'" }>
							<button class="icon-btn add-btn" title="Add alias"
								data-on:click={ "evt.stopPropagation(); $editingDevice = '" + jsEscape(dev.UID) + "'; $newAlias = ''" }>+</button>
						</div>
					</div>
				</div>
			</div>
			<div class="row-actions">
				if dev.IsDefault {
					<span class="badge badge-core">Default</span>
				}
			</div>
		</div>
	}
}

templ Sound(data soundSettingsData) {
	<bk-table columns="1fr 1fr"
		data-signals={ fmt.Sprintf(`{"volume": %d, "muted": %s}`, data.Volume, strconv.FormatBool(data.Muted)) }>
		<div class="settings-row">
			<div class="label">Volume</div>
			<div class="value-cell sound-stepper">
				<button class="segmented-btn"
					data-on:click={ fmt.Sprintf("$volume = %d; @post('" + branchkit.MethodURL("set-volume") + "')", data.VolumeMinus) }>&#8722;</button>
				<span class="sound-volume-readout">{ fmt.Sprintf("%d", data.Volume) }%</span>
				<button class="segmented-btn"
					data-on:click={ fmt.Sprintf("$volume = %d; @post('" + branchkit.MethodURL("set-volume") + "')", data.VolumePlus) }>+</button>
			</div>
		</div>
		<div class="settings-row">
			<div class="label">Mute</div>
			<div class="value-cell sound-toggle">
				if data.Muted {
					<button class="segmented-btn is-active"
						data-on:click={ "$muted = true; " + branchkit.MethodPost("set-mute", "") }>On</button>
					<button class="segmented-btn"
						data-on:click={ "$muted = false; " + branchkit.MethodPost("set-mute", "") }>Off</button>
				} else {
					<button class="segmented-btn"
						data-on:click={ "$muted = true; " + branchkit.MethodPost("set-mute", "") }>On</button>
					<button class="segmented-btn is-active"
						data-on:click={ "$muted = false; " + branchkit.MethodPost("set-mute", "") }>Off</button>
				}
			</div>
		</div>
	</bk-table>
	if len(data.Outputs) > 0 {
		<bk-table columns="2fr 100px" class="sound-table">
			<div class="table-header">
				<div>Output Devices</div>
				<div class="align-right">Status</div>
			</div>
			@deviceList(data.Outputs, "output")
		</bk-table>
	}
	if len(data.Inputs) > 0 {
		<bk-table columns="2fr 100px" class="sound-table">
			<div class="table-header">
				<div>Input Devices</div>
				<div class="align-right">Status</div>
			</div>
			@deviceList(data.Inputs, "input")
		</bk-table>
	}
	<div class="sound-hints">
			<div class="sound-hints-title">Voice Commands</div>
			<div class="sound-hints-grid">
				<span><code>volume up</code> / <code>volume down</code></span>
				<span><code>mute</code> / <code>unmute</code></span>
				<span><code>set output &lt;name&gt;</code></span>
				<span><code>set input &lt;name&gt;</code></span>
			</div>
	</div>
}
