package main

import "fmt"
import "strconv"

templ deviceList(devices []deviceView, deviceType string) {
	for _, dev := range devices {
		<div class="settings-row" style="grid-template-columns: 2fr 100px;">
			<div class="label">
				<div style="display: flex; align-items: center; gap: 8px;">
					<span style="cursor: pointer;" data-on:click={ "@post('/v1/plugins/system/methods/set-device', {payload: {uid: '" + jsEscape(dev.UID) + "', device_type: '" + deviceType + "'}})" }>{ dev.Name }</span>
				</div>
				<div style="margin-top: 4px;">
					<div class="alias-tags">
						<code style="font-size: 11px; color: #666;">{ "set " + deviceType + " " + dev.VoiceHint }</code>
						for _, alias := range dev.Aliases {
							<span class="alias-tag">
								{ alias }
								<button data-on:click={ "@post('/v1/plugins/system/methods/device-alias-remove', {payload: {uid: '" + jsEscape(dev.UID) + "', newAlias: '" + jsEscape(alias) + "'}})" }>&#215;</button>
							</span>
						}
						<div data-show={ "$editingDevice === '" + jsEscape(dev.UID) + "'" }>
							<input class="add-alias-input" type="text" data-bind:newAlias placeholder="e.g. headphones"
								data-on:keydown={ "evt.key === 'Enter' && (@post('/v1/plugins/system/methods/device-alias-add', {payload: {uid: '" + jsEscape(dev.UID) + "', newAlias: $newAlias}}), $editingDevice = ''); evt.key === 'Escape' && ($editingDevice = '')" }
								data-on:blur__debounce.150ms="$editingDevice = ''"/>
						</div>
						<div data-show={ "$editingDevice !== '" + jsEscape(dev.UID) + "'" }>
							<button class="icon-btn" style="opacity: 1; font-size: 16px;" title="Add alias"
								data-on:click={ "evt.stopPropagation(); $editingDevice = '" + jsEscape(dev.UID) + "'; $newAlias = ''" }>+</button>
						</div>
					</div>
				</div>
			</div>
			<div class="row-actions">
				if dev.IsDefault {
					<span class="badge badge-core">Default</span>
				}
			</div>
		</div>
	}
}

templ Sound(data soundSettingsData) {
	<div id="settings-table-container" class="settings-table"
		data-signals={ fmt.Sprintf(`{"volume": %d, "muted": %s}`, data.Volume, strconv.FormatBool(data.Muted)) }>
		<div class="settings-row" style="grid-template-columns: 1fr 1fr;">
			<div class="label">Volume</div>
			<div style="text-align: right; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
				<button style="font-size: 13px; padding: 2px 10px; min-width: 28px;"
					data-on:click={ fmt.Sprintf("$volume = %d; @post('/v1/plugins/system/methods/set-volume')", data.VolumeMinus) }>&#8722;</button>
				<span style="font-family: 'SF Mono', monospace; min-width: 40px; text-align: center;">{ fmt.Sprintf("%d", data.Volume) }%</span>
				<button style="font-size: 13px; padding: 2px 10px; min-width: 28px;"
					data-on:click={ fmt.Sprintf("$volume = %d; @post('/v1/plugins/system/methods/set-volume')", data.VolumePlus) }>+</button>
			</div>
		</div>
		<div class="settings-row" style="grid-template-columns: 1fr 1fr;">
			<div class="label">Mute</div>
			<div style="text-align: right; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
				if data.Muted {
					<button style="font-size: 13px; padding: 2px 10px; min-width: 40px; font-weight: bold;"
						data-on:click="$muted = true; @post('/v1/plugins/system/methods/set-mute')">On</button>
					<button style="font-size: 13px; padding: 2px 10px; min-width: 40px;"
						data-on:click="$muted = false; @post('/v1/plugins/system/methods/set-mute')">Off</button>
				} else {
					<button style="font-size: 13px; padding: 2px 10px; min-width: 40px;"
						data-on:click="$muted = true; @post('/v1/plugins/system/methods/set-mute')">On</button>
					<button style="font-size: 13px; padding: 2px 10px; min-width: 40px; font-weight: bold;"
						data-on:click="$muted = false; @post('/v1/plugins/system/methods/set-mute')">Off</button>
				}
			</div>
		</div>
		if len(data.Outputs) > 0 {
			<div class="table-header" style="grid-template-columns: 2fr 100px; margin-top: 16px;">
				<div>Output Devices</div>
				<div style="text-align: right;">Status</div>
			</div>
			@deviceList(data.Outputs, "output")
		}
		if len(data.Inputs) > 0 {
			<div class="table-header" style="grid-template-columns: 2fr 100px; margin-top: 16px;">
				<div>Input Devices</div>
				<div style="text-align: right;">Status</div>
			</div>
			@deviceList(data.Inputs, "input")
		}
		<div style="margin-top: 24px; padding: 12px 16px; background: rgba(255,255,255,0.03); border-radius: 8px; font-size: 12px; color: #888;">
			<div style="margin-bottom: 6px; font-weight: 600; color: #aaa;">Voice Commands</div>
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px;">
				<span><code>volume up</code> / <code>volume down</code></span>
				<span><code>mute</code> / <code>unmute</code></span>
				<span><code>set output &lt;name&gt;</code></span>
				<span><code>set input &lt;name&gt;</code></span>
			</div>
		</div>
	</div>
}
