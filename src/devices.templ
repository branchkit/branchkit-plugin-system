package main

import "fmt"

templ Devices(devices []hidDeviceView) {
	<bk-table columns="2fr 1fr 1fr">
		if len(devices) == 0 {
			<div class="devices-empty">
				No HID devices connected.
			</div>
		} else {
			<div class="table-header">
				<div>Device</div>
				<div>Transport</div>
				<div class="align-right">Inputs</div>
			</div>
			for _, dev := range devices {
				<div class="settings-row">
					<div class="label">
						<span>{ dev.Name }</span>
						<div class="device-ids">
							<code>{ fmt.Sprintf("%04x:%04x", dev.VendorID, dev.ProductID) }</code>
							if dev.Seized {
								<span class="badge badge-core device-claimed">Claimed</span>
							}
						</div>
					</div>
					<div>{ dev.Transport }</div>
					<div class="device-inputs">
						if dev.Buttons > 0 && dev.Axes > 0 {
							{ fmt.Sprintf("%d buttons, %d axes", dev.Buttons, dev.Axes) }
						} else if dev.Buttons > 0 {
							{ fmt.Sprintf("%d buttons", dev.Buttons) }
						} else if dev.Axes > 0 {
							{ fmt.Sprintf("%d axes", dev.Axes) }
						}
					</div>
				</div>
			}
		}
	</bk-table>
}
