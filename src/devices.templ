package main

import "fmt"

templ Devices(devices []hidDeviceView) {
	<div id="settings-table-container" class="settings-table">
		if len(devices) == 0 {
			<div style="padding: 24px 16px; text-align: center; color: #888;">
				No HID devices connected.
			</div>
		} else {
			<div class="table-header" style="grid-template-columns: 2fr 1fr 1fr;">
				<div>Device</div>
				<div>Transport</div>
				<div style="text-align: right;">Inputs</div>
			</div>
			for _, dev := range devices {
				<div class="settings-row" style="grid-template-columns: 2fr 1fr 1fr;">
					<div class="label">
						<span>{ dev.Name }</span>
						<div style="margin-top: 2px; font-size: 11px; color: #666;">
							<code>{ fmt.Sprintf("%04x:%04x", dev.VendorID, dev.ProductID) }</code>
							if dev.Seized {
								<span class="badge badge-core" style="margin-left: 6px;">Claimed</span>
							}
						</div>
					</div>
					<div>{ dev.Transport }</div>
					<div style="text-align: right; font-size: 12px; color: #999;">
						if dev.Buttons > 0 && dev.Axes > 0 {
							{ fmt.Sprintf("%d buttons, %d axes", dev.Buttons, dev.Axes) }
						} else if dev.Buttons > 0 {
							{ fmt.Sprintf("%d buttons", dev.Buttons) }
						} else if dev.Axes > 0 {
							{ fmt.Sprintf("%d axes", dev.Axes) }
						}
					</div>
				</div>
			}
		}
	</div>
}
